# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=            # "Stock Checkers" category id
DISCORD_OPS_CHANNEL_ID=        # #ops channel for observability

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- eBay (Browse API, also powers market price) ----
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=            # optional; client-credentials used for Browse API
EBAY_ENV=production            # production | sandbox

# ---- Market price ----
PRICECHARTING_API_KEY=

# ---- Walmart / hostile adapters (optional) ----
PROXY_POOL_URL=

# ---- Engine tuning ----
GLOBAL_POLL_INTERVAL_SEC=45
ALERT_COOLDOWN_SEC=300
POLL_JITTER_PCT=0.2
ADAPTER_CONCURRENCY=4
MARKET_CACHE_TTL_SEC=43200     # 12h

# ---- Logging ----
LOG_LEVEL=info                 # debug | info | warn | error
