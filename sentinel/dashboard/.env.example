# Sentinel dashboard — server-side only (never exposed to the browser).
# Use a READ-ONLY Supabase key here, NOT the worker's service key (PRD §20).
# Without RLS in v1, the `anon` key works once you grant read on the tables, or
# create a dedicated read-only role/key.
SUPABASE_URL=
SUPABASE_READONLY_KEY=
